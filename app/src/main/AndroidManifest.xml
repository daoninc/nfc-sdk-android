<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NFC hardware access — normal permission, no runtime request needed. -->
    <uses-permission android:name="android.permission.NFC" />
    <!--
        Mark NFC as not strictly required so the app can be installed on devices without it.
        NfcViewModel.startScan() uses NFCReader.isSupported() to handle the no-hardware case.
    -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:label="Daon NFC Sample App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
